# OpenAI - nunca exponha estas variáveis no frontend
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_COACHING_MODEL=gpt-5.4-mini
AUDITORIA_COACHING_MIN_CHARS=320
AUDITORIA_OPENAI_TIMEOUT_SECONDS=600

# Upload e retenção
AUDITORIA_STORAGE_PATH=
AUDITORIA_MAX_FILE_SIZE_MB=25

# Worker. Em desenvolvimento pode ficar embutido no Flask.
# Em produção, prefira false e execute um processo separado.
AUDITORIA_EMBEDDED_WORKER=true
AUDITORIA_WORKER_POLL_SECONDS=5
AUDITORIA_WORKER_MAX_ATTEMPTS=3
