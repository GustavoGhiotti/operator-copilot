# Destinatário inicial de teste. Para vários destinatários, separe por vírgula.
AURORA_INSIGHT_EMAIL_TO=relatorios@empresa.example
AURORA_INSIGHT_TIMEZONE=America/Sao_Paulo

# Google Workspace: use smtp-relay.gmail.com para relay autorizado pelo IP.
# Para uma conta com senha de app, use smtp.gmail.com.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30

# No relay por IP, usuário e senha podem permanecer vazios.
# Com autenticação, informe a conta, uma senha de app do Google Workspace e
# troque SMTP_HOST para smtp.gmail.com.
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
